{
  "name": "service-bus-explorer-web",
  "version": "1.0.0",
  "private": true,
  "description": "Modern web-based Azure Service Bus Explorer built with React and NestJS",
  "author": "Service Bus Explorer Team",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "api:dev": "turbo run dev --filter=api",
    "web:dev": "turbo run dev --filter=web",
    "desktop:dev": "concurrently -k -n API,WEB,ELECTRON -c blue,green,yellow \"pnpm api:dev\" \"pnpm web:dev\" \"wait-on http://localhost:5173 && pnpm --filter @service-bus-explorer/desktop dev\"",
    "desktop:dist": "bash apps/desktop/scripts/build.sh && pnpm --filter @service-bus-explorer/desktop dist",
    "desktop:dist:mac": "bash apps/desktop/scripts/build.sh && pnpm --filter @service-bus-explorer/desktop dist:mac",
    "desktop:dist:win": "bash apps/desktop/scripts/build.sh && pnpm --filter @service-bus-explorer/desktop dist:win",
    "desktop:dist:linux": "bash apps/desktop/scripts/build.sh && pnpm --filter @service-bus-explorer/desktop dist:linux"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.2.5",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "wait-on": "^9.0.4"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18.0.0"
  }
}
